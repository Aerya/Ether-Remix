{
  "id": "org.ether.sports",
  "version": "2.0.0",
  "name": "Sports",
  "description": "Live scores, standings and schedules across 17 leagues from ESPN.",
  "ether": {
    "protocol": 1,
    "kind": "extension",
    "capabilities": [
      "live_events",
      "screens"
    ],
    "summary": "$t:summary",
    "icon": "assets/icon.svg",
    "runtime": {
      "kind": "hosted",
      "entry": "src/plugin.ts",
      "limits": {
        "memoryBytes": 67108864
      }
    },
    "permissions": {
      "network": [
        "site.api.espn.com",
        "site.web.api.espn.com",
        "a.espncdn.com"
      ]
    },
    "strings": {
      "en": "i18n/en.json",
      "fr": "i18n/fr.json"
    },
    "settings": {
      "$ref": "settings.schema.json"
    },
    "contributes": {
      "liveFeeds": [
        {
          "id": "sports",
          "title": "$t:feed_title",
          "minIntervalSec": 15,
          "entityKinds": [
            "team"
          ]
        }
      ],
      "screens": [
        {
          "id": "sports",
          "title": "$t:screen_title",
          "icon": "trophy",
          "pages": {
            "index": "screens/sports.json",
            "game": "screens/game.json"
          }
        }
      ],
      "surfaces": [
        {
          "id": "scorebug",
          "presentation": "playerOverlay",
          "title": "$t:surface_scorebug",
          "anchor": "topLeft",
          "visibility": "always",
          "setting": {
            "id": "scorebug",
            "label": "$t:setting_scorebug",
            "default": true
          },
          "when": {
            "event": {
              "feed": "sports"
            }
          },
          "document": "surfaces/scorebug.json"
        },
        {
          "id": "ticker",
          "presentation": "playerOverlay",
          "title": "$t:surface_ticker",
          "anchor": "bottom",
          "visibility": "toggle",
          "setting": {
            "id": "ticker",
            "label": "$t:setting_ticker",
            "default": false
          },
          "when": {
            "kind": "channel"
          },
          "document": "surfaces/ticker.json"
        },
        {
          "id": "alert",
          "presentation": "toast",
          "title": "$t:surface_alert",
          "document": "surfaces/alert.json"
        },
        {
          "id": "tonight",
          "presentation": "homeRow",
          "title": "$t:surface_tonight",
          "document": "surfaces/tonight.json"
        }
      ]
    }
  }
}
